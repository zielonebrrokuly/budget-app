// Odchudzona apka budżetowa — schemat świeży, tylko potrzebne modele.
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id                String   @id @default(cuid())
  type              String // "EXPENSE" | "INCOME"
  date              DateTime
  amount            Float
  description       String?
  category          String
  deductedFromFood  Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([type, date])
}

model Category {
  id        String     @id @default(cuid())
  type      String // "EXPENSE" | "INCOME"
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  createdAt DateTime   @default(now())

  @@unique([type, name])
  @@index([parentId])
}

model Setting {
  key   String @id
  value String
}

model PlannedExpense {
  id        String   @id @default(cuid())
  year      Int
  month     Int // 0-11
  name      String
  amount    Float? // opcjonalna — pozycja może być zwykłym zadaniem bez kwoty
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([year, month])
}

model TransactionAudit {
  id             String    @id @default(cuid())
  transactionId  String
  action         String // "UPDATED" | "DELETED"
  type           String // "EXPENSE" | "INCOME"
  oldDate        DateTime
  oldAmount      Float
  oldCategory    String
  oldDescription String?
  newDate        DateTime?
  newAmount      Float?
  newCategory    String?
  newDescription String?
  changedAt      DateTime  @default(now())

  @@index([changedAt])
}

// Śledzenie nawyków: definicja nawyku + jeden wpis na każdy odhaczony dzień.
// Brak wpisu = nieodhaczone, więc odznaczenie po prostu kasuje wiersz.
model Habit {
  id        String       @id @default(cuid())
  name      String       @unique
  sortOrder Int          @default(0)
  // Archiwizacja zamiast usuwania — nawyk znika z listy, ale historia zostaje.
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())
  entries   HabitEntry[]
}

model HabitEntry {
  id      String   @id @default(cuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime // północ dnia, tak samo jak zakresy miesięcy w queries.ts

  @@unique([habitId, date])
  @@index([date])
}
